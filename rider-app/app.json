{
  "expo": {
    "name": "ChowBuy Rider",
    "slug": "chowbuy-rider",
    "scheme": "chowbuyrider",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.chowbuy.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ChowBuy Rider uses your location to guide deliveries and let customers follow your order.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ChowBuy Rider keeps tracking your delivery while the screen is off.",
        "NSMicrophoneUsageDescription": "Used to record voice notes to customers."
      }
    },
    "android": {
      "package": "ng.chowbuy.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECORD_AUDIO"
      ],
      "splash": {
        "backgroundColor": "#FFFFFF",
        "resizeMode": "native",
        "mdpi": "./assets/splash/splash-mdpi.png",
        "hdpi": "./assets/splash/splash-hdpi.png",
        "xhdpi": "./assets/splash/splash-xhdpi.png",
        "xxhdpi": "./assets/splash/splash-xxhdpi.png",
        "xxxhdpi": "./assets/splash/splash-xxxhdpi.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "ChowBuy Rider keeps tracking your delivery while the screen is off."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChowBuy Rider needs your photos so you can send your documents for verification."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
