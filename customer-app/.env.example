# Copy to .env for local runs (npx expo start). Leave EXPO_PUBLIC_SUPABASE_URL empty to stay in demo mode.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY   # the publishable/anon key only. Never put the service_role key in the app.
EXPO_PUBLIC_PAY_URL=https://pay.chowbuy.ng
# EXPO_PUBLIC_DEMO=1    # force demo mode even when a Supabase URL is set
