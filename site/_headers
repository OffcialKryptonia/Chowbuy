# The admin console files change often: always revalidate so a stale copy is never served.
/admin/*
  Cache-Control: no-cache
/assets/content.js
  Cache-Control: no-cache

# The merchant service worker and manifest must always revalidate so updates reach installed apps.
/merchant/sw.js
  Cache-Control: no-cache
/merchant/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/merchant/pwa.js
  Cache-Control: no-cache

/OneSignalSDKWorker.js
  Cache-Control: no-cache
  Content-Type: application/javascript; charset=utf-8
